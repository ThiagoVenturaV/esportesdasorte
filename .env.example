# Segredo usado apenas no backend (Vercel Function api/edson/chat)
GROQ_API_KEY=sua_chave_groq_backend_aqui

# Opcional para fallback local do frontend durante desenvolvimento
VITE_GROQ_KEY=sua_chave_groq_fallback_local_aqui

# Ajustes de comportamento do Edson
VITE_EDSON_MAX_HISTORY=10
VITE_TYPEWRITER_SPEED=18
EDSON_MAX_HISTORY=10