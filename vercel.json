{
  "rewrites": [
    {
      "source": "/api-v2/:path*",
      "destination": "https://esportesdasorte.bet.br/api-v2/:path*"
    },
    {
      "source": "/api-generic/:path*",
      "destination": "https://esportesdasorte.bet.br/api-generic/:path*"
    },
    {
      "source": "/bragi/:path*",
      "destination": "https://bragi.sportingtech.com/:path*"
    },
    {
      "source": "/betano-api/:path*",
      "destination": "https://www.betano.bet.br/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
