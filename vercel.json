{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api-v2/:path*",
      "destination": "https://esportesdasorte.bet.br/api-v2/:path*"
    },
    {
      "source": "/api-generic/:path*",
      "destination": "https://esportesdasorte.bet.br/api-generic/:path*"
    },
    {
      "source": "/bragi/:path*",
      "destination": "https://bragi.sportingtech.com/:path*"
    },
    {
      "source": "/betano-api/:path*",
      "destination": "https://www.betano.bet.br/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
